# Copy this file to .env and fill in YOUR OWN keys. Never commit .env or share keys in chat.
# (Alternative: put the same names in .streamlit/secrets.toml - see secrets.toml.example. Environment/.env values win.)

# ---- Weather -------------------------------------------------------------------------------------------
# auto (default) = WeatherAPI.com if WEATHERAPI_KEY is set, otherwise the free key-less Open-Meteo service.
# Force one with: openmeteo  or  weatherapi.   (Open-Meteo's free service is for NON-COMMERCIAL use only.)
# WEATHER_PROVIDER=auto
# Only needed for the WeatherAPI provider (https://www.weatherapi.com/)
WEATHERAPI_KEY=2ee7918e47c04bc1b9270515262410
# How long weather results are reused before asking the service again (default 10)
# WEATHER_CACHE_MINUTES=10

# ---- Gemini (optional) -----------------------------------------------------------------------------------
GEMINI_API_KEY=AQ.Ab8RN6Jr0EvJCWu5WKJEpBn_Ovqv6iPAyAjrAgsckgGedrckYw
# Set to false to switch every Gemini feature off (no Gemini calls at all; the app uses its built-in rules)
ENABLE_GEMINI=true

# Models. Leave these blank/commented to use the defaults (a newer model first, then the older one if your key can't use it).
# Several names separated by commas = "try in this order". Use the "Check which models my key can use" button in the
# Voice Assistant tab to see what your key can use. Text/photo analysis and image generation are configured separately.
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite,gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image,gemini-2.5-flash-image

# Quota protection (defaults shown)
# GEMINI_CACHE_MINUTES=30             identical requests are answered from memory for this long (0 = off)
# GEMINI_QUOTA_COOLDOWN_MINUTES=15    pause Gemini this long after a quota / 429 error
# GEMINI_MAX_CALLS_PER_MINUTE=10      burst limiter (0 = off)
# GEMINI_MAX_CALLS_PER_DAY=0          optional daily cap while the app is running (0 = off)
# GEMINI_MAX_RETRIES=2                retries for temporary errors only (never for quota errors)
# GEMINI_TIMEOUT_SECONDS=30

# ---- Other optional settings ---------------------------------------------------------------------------
# Where consent-based preferences are saved (default: user_preferences.json next to app.py)
# WEATHERFIT_PREFS_FILE=user_preferences.json
# Where the SQLite database and private image folders live (defaults: weatherfit.db and data/ next to app.py)
# WEATHERFIT_DB=weatherfit.db
# WEATHERFIT_DATA_DIR=data
# Set to 1 to run the live Gemini tests in tests_live/ (uses real quota)
# WEATHERFIT_LIVE_TESTS=1
# Optional: your own trained try-on model, as module:function (see README, 'Virtual try-on & avatar')
# TRYON_ADAPTER=my_tryon_model:run
